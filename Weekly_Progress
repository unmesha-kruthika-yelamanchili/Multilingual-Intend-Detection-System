        "print(\"MuRIL loaded successfully.\")\n",
        "print(\"Model:\", MODEL_NAME)\n",
        "print(\"Hidden size:\", muril.config.hidden_size)\n",
        "print(\"Number of layers:\", muril.config.num_hidden_layers)"
      ]
